APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NAME="The Vault"
TRUST_PROXY=false

# Legal / privacy (fill before public launch)
LEGAL_CONTROLLER_NAME="[Your name or company name]"
LEGAL_REGISTRY_CODE=
LEGAL_ADDRESS="[Street, city, country]"
LEGAL_EMAIL=privacy@example.com
LEGAL_COUNTRY=EE
LEGAL_HOSTING_PROVIDER="[Hosting provider name]"
LEGAL_SMTP_PROVIDER="[SMTP provider name]"
LEGAL_PRIVACY_VERSION=2026-09-19
LEGAL_TERMS_VERSION=2026-09-19
LEGAL_BANK_AIS_VERSION=2026-09-19

DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=php_learn
DB_NAME_TEST=php_learn_test
DB_USER=root
DB_PASSWORD=root

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=noreply@localhost.dev
MAIL_FROM_NAME=PhpLearn

ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_APP_ID=your-application-id-uuid
ENABLE_BANKING_PRIVATE_KEY_PATH=secrets/enablebanking/your-application-id-uuid.pem
ENABLE_BANKING_REDIRECT_URL=http://localhost:8000/bank/lhv/callback

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# Serverless hosting (Vercel). All optional; leave unset locally.
# LOG_TO_STDERR=true            # log to the platform log stream instead of a file
# SESSION_DRIVER=database       # files (default) or database; defaults to database when VERCEL is set
# DB_SSL=true                   # TLS to the database; uses the system CA bundle unless one of the next two is set
# DB_SSL_CA=secrets/db-ca.pem
# DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
